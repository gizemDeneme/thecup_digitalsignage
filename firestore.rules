rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin' &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isActiveAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // TV app reads without auth; only active admin can write
    match /playlists/{doc} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // TV app reads content; only active admin can write
    match /content/{doc} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // Admin records: any active admin can read; only active super_admin can write.
    // A user can update their own lastLoginAt field.
    match /admins/{uid} {
      allow read: if isActiveAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastLoginAt']));
    }

    // Audit logs: append-only. Any active admin can read & create; nobody updates/deletes.
    match /audit_logs/{doc} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Screens: TV unauthenticated olarak lastSeenAt günceller; admin her şeyi yönetir.
    match /screens/{deviceId} {
      allow read: if true;
      allow create: if true;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
