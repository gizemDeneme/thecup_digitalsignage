rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // TV app reads without auth; only admin can write
    match /playlists/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TV app reads content; only admin can write
    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Only admin can access admin records
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
